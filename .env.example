# No key = clearly labeled demo mode. Never prefix secrets with VITE_.
IP_API_KEY=
IP_API_URL=https://api.ipdata.co/
PORT=3000
HOST=127.0.0.1
# Explicit trusted proxy IPs/CIDRs only; blank trusts no forwarded headers.
TRUSTED_PROXY_CIDRS=
CACHE_TTL_SECONDS=300
PROVIDER_TIMEOUT_MS=8000
DEMO_MODE=false
# Public map configuration, compiled at build time. No secret keys here.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
